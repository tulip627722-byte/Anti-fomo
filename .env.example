# 反 FOMO v2.0 - 环境变量配置示例

# ==================== 必需配置 ====================

# PostgreSQL 数据库 (Neon)
# 获取: https://neon.tech/
DATABASE_URL="postgresql://user:password@host/database"

# 全网搜索 API 配置（可选，任选一个）
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=your_serpapi_key

# 或使用 Google Custom Search
# SEARCH_PROVIDER=google
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_CSE_ID=your_cse_id

# 或使用 Bing Search
# SEARCH_PROVIDER=bing
# BING_API_KEY=your_bing_api_key

# ==================== 可选配置 ====================

# AI 模型配置（支持 OpenAI 兼容 API）
# API_BASE_URL=https://api.openai.com/v1
# API_KEY=your_api_key
# AI_MODEL=gpt-4o-mini

# 默认为本地 PROFILES，如果设置了上述 API 则优先使用 API

# ==================== 说明 ====================

# 如果没有配置搜索 API，系统会自动降级到本地硬编码的知识库
# 硬编码的知识库包括：RAG、Mamba、LoRA、AI Agent、Harness、Transformer 等

# 本应用采用三维度分析：
# - 核心价值（Core Value）
# - 应用前景（Application Prospect）
# - 学习成本（Learning Cost）
# 每个维度包含详细描述和简明结论
